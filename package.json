{
  "name": "molbhav",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "measure": "tsx scripts/measure-app.ts",
    "eval:extract": "tsx --env-file-if-exists=.env.local scripts/eval-extract.ts",
    "eval:parse": "tsx --env-file-if-exists=.env.local scripts/eval-parse.ts",
    "fonts": ".venv/bin/python scripts/fonts.py",
    "icons": "tsx scripts/icons.ts",
    "postinstall": "node scripts/og-wasm.mjs",
    "icons:bold": "tsx scripts/icons-bold.ts",
    "bolna:build": "tsx scripts/bolna-sync.ts --build-only",
    "bolna:sync": "tsx --env-file-if-exists=.env.local scripts/bolna-sync.ts",
    "bolna:check": "tsx --env-file-if-exists=.env.local scripts/bolna-check.ts",
    "bolna:voice": "tsx scripts/bolna-voice.ts",
    "team:setup": "tsx scripts/team-setup.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "0.0.98",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/workpool": "^0.4.16",
    "botid": "1.5.12",
    "clsx": "^2.1.1",
    "convex": "1.50.0",
    "convex-helpers": "0.1.135",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vercel-og": "npm:@vercel/og@1.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bolna/web-call": "3.0.1",
    "@edge-runtime/vm": "^5.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.71",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "harfbuzzjs": "0.10.0",
    "size-limit": "^14.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
