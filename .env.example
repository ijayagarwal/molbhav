# Molbhav environment variables. Never commit real values.
# This file is a reference list, not a loadable .env (some names appear in two places on purpose).
#
# Where each value goes:
#   (1) .env.local      local development only (gitignored). Holds the public values and,
#                       for local dev only, the Next.js server secrets in section 2.
#   (2) Vercel env      Production and Preview. Server secrets for the deployed Next.js app.
#   (3) Convex env      per deployment: `npx convex env set NAME value` (dev),
#                       `npx convex env set --prod NAME value` (production); the demo project has its own.
# Never put a secret in a NEXT_PUBLIC_* variable.

# ── (1) Public values: .env.local and Vercel ──────────────────────────
CONVEX_DEPLOYMENT=                # .env.local ONLY; written by `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=           # written by `npx convex dev`; on Vercel set by `npx convex deploy`
NEXT_PUBLIC_WHATSAPP_NUMBER=      # team WhatsApp Business number for click-to-chat, digits only, e.g. 9198xxxxxxxx

# ── (2) Next.js server secrets: Vercel env (and .env.local for local dev) ──
# Every module that reads these starts with: import "server-only"
CONVEX_DEPLOY_KEY=                # Vercel ONLY: one key for Production; a different one for Preview only if the Convex plan has preview keys
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4        # confirm the current id in Sarvam docs
SARVAM_TTS_MODEL=                 # Bulbul v4 Flash model id from Sarvam docs (read-back route /api/tts)
SARVAM_TTS_SPEAKER=               # a Hindi voice from Sarvam docs
GEMINI_MODEL=                     # current Gemini Flash model id from Google AI Studio
GEMINI_API_KEY=                   # FREE tier: local development only, team test speech (Google may use prompts)
GEMINI_API_KEY_BILLED=            # billed project: production, any real contractor speech
GEMINI_API_KEY_SANDBOX=           # separate billed project for /try, so its kill switch is isolated
CONVEX_SERVER_SECRET=             # long random string; the SAME value in Convex env
HASH_SECRET=                      # long random string for HMAC of IPs and phones; the SAME value in Convex env

# ── (3) Convex env (per deployment) ───────────────────────────────────
# Convex Auth: JWT_PRIVATE_KEY, JWKS and SITE_URL are set by `npx @convex-dev/auth` (once per deployment).
CONVEX_SERVER_SECRET=             # same as in Vercel
HASH_SECRET=                      # same as in Vercel
ADMIN_USER_IDS=                   # comma-separated Convex Auth user ids (Data → users → _id)
REC_TOKEN_SECRET=                 # HMAC key for /rec/:callId?t= recording tokens (B6)

SARVAM_API_KEY=                   # for the spoken result (tts.summary) from Convex
SARVAM_TTS_MODEL=
SARVAM_TTS_SPEAKER=
GEMINI_MODEL=
GEMINI_API_KEY=                   # free tier: sim personas and fixtures only
GEMINI_API_KEY_BILLED=            # required before any live call (guard 8)

# Simulator
SIM_PACE=demo                     # demo (about 1 min sweep) or realistic (2–4 min)
SIM_EXTRACT=groundtruth           # groundtruth (no LLM; tests and demos) or llm (exercise the real extractor)

# Bolna (Phases 8A–8C)
BOLNA_API_KEY=
BOLNA_QUOTE_AGENT_ID=
BOLNA_HAGGLE_AGENT_ID=
BOLNA_MATCH_AGENT_ID=
BOLNA_CONFIRM_AGENT_ID=
BOLNA_WEBHOOK_SECRET=             # long random string; Bolna sends it as the x-molbhav-secret header
BOLNA_FROM_NUMBER=                # Indian number registered to the business (Bolna, or your own Plivo/Exotel account connected in Bolna), declared for A2P (E.164). Required unless BOLNA_TRIAL=true.

# Trial mode (B9): test on teammates' verified phones before the business number exists
BOLNA_TRIAL=false
TEST_PHONE_HASHES=                # comma-separated HMAC hashes of teammates' numbers (also verified in Bolna)
TEST_DAILY_CALLS=10               # per test number per day in trial mode; 15 on Team test days

# Live-call guards (ARCHITECTURE.md §11). Any failed guard means no dial; a full live slot means wait (R2).
LIVE_CALLS_ENABLED=false
CALL_HOURS_START=10               # IST, Asia/Kolkata
CALL_HOURS_END=19
ALLOW_SUNDAY=false
MAX_LIVE_SWEEPS_PER_HOUR=3        # checked when a live sweep starts (R2); 6 on Team test days
MAX_LIVE_CALLS_PER_ORDER=12
LIVE_CONCURRENCY=2                # live slots claimDial counts (R2); 2 on the Bolna trial; raise to your plan's limit (paid plans start at 10)

# Milestone 2 go-live (Phase 10)
A2P_DECLARED=false                # set true only after the provider confirms the A2P declaration in writing
LIVE_STAGE=1                      # 1: admins only, at most STAGE1_MAX_DEALERS dealers; 2: verified contractors, all opted-in dealers
STAGE1_MAX_DEALERS=5

# Flow
UNDO_WINDOW_SEC=120               # live; sim demo pace uses 5 s

# Sandbox /try (G3)
SANDBOX_DAILY_INR_CAP=200         # kill switch: /try stops for the day once its STT + LLM spend reaches this
VOICE_DAILY_INR_CAP=500           # kill switch for /api/voice/order and /api/tts across all users

# Demo
DEMO_DEPLOYMENT=false             # true on dev (from Phase 7) and on molbhav-demo; never on prod
